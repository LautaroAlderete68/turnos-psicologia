# ==========================================
# Configuración del Sistema de Turnos
# ==========================================

# Puerto y URL base de la aplicación
PORT=3000
NEXT_PUBLIC_APP_URL="https://turnos-psicologia.vercel.app"

# Base de datos (PostgreSQL con Prisma)
DATABASE_URL="postgresql://usuario:contraseña@servidor:5432/turnos_db?schema=public"

# Clave secreta para JWT de sesiones de Administrador (generar con `openssl rand -hex 32`)
JWT_SECRET="cambiar-por-un-secreto-criptografico-seguro-de-al-menos-32-caracteres"

# Almacenamiento de comprobantes de pago (DRIVERS: "local" o "s3")
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/proofs"

# ==========================================
# Proveedor de Correo Electrónico
# ==========================================
# Opciones para EMAIL_DRIVER: "gmail", "smtp", "resend", "console"

# --- OPCIÓN 1: Enviar desde Gmail personal / profesional ---
EMAIL_DRIVER="gmail"
EMAIL_FROM="Lic. Marisa Ebhardt <contactopsicotp@gmail.com>"
GMAIL_USER="contactopsicotp@gmail.com"
GMAIL_APP_PASSWORD="tu-contraseña-de-aplicacion-de-16-letras"

# --- OPCIÓN 2: SMTP Genérico ---
# EMAIL_DRIVER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASS="tu-contraseña-de-aplicacion"

# --- OPCIÓN 3: Resend ---
# EMAIL_DRIVER="resend"
# RESEND_API_KEY="re_123456789"

# ==========================================
# Automatización de Salas Virtuales (Google Meet / Zoom)
# ==========================================
# Proveedores soportados: "auto", "meet", "zoom", "custom"
VIRTUAL_MEETING_PROVIDER="auto"

# Sala predeterminada fija de la profesional (Google Meet / Zoom PMI):
# VIRTUAL_MEETING_DEFAULT_URL="https://meet.google.com/abc-defg-hij"

# Integración con Zoom API (Server-to-Server OAuth):
# ZOOM_ACCOUNT_ID="tu-zoom-account-id"
# ZOOM_CLIENT_ID="tu-zoom-client-id"
# ZOOM_CLIENT_SECRET="tu-zoom-client-secret"

# Configuración inicial del primer administrador (usado en prisma/seed.ts)
INITIAL_ADMIN_EMAIL="lic.consultorio@gmail.com"
INITIAL_ADMIN_PASSWORD="CambiarEstaPassword123!"
INITIAL_ADMIN_NAME="Lic. Marisa Ebhardt"
