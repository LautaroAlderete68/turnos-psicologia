# ==========================================
# Configuración del Sistema de Turnos
# ==========================================

# Puerto y URL base de la aplicación
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de datos (PostgreSQL con Prisma)
# En producción (ej. Supabase, Neon, Railway):
# DATABASE_URL="postgresql://usuario:contraseña@servidor:5432/turnos_db?schema=public"
# En entorno local/desarrollo también puede usarse PostgreSQL o SQLite:
DATABASE_URL="file:./dev.db"

# Clave secreta para JWT de sesiones de Administrador (generar con `openssl rand -hex 32`)
JWT_SECRET="cambiar-por-un-secreto-criptografico-seguro-de-al-menos-32-caracteres"

# Almacenamiento de comprobantes de pago (DRIVERS: "local" o "s3")
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/proofs"

# Configuración S3 / Cloudflare R2 / MinIO (Requerido solo si STORAGE_DRIVER="s3")
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="comprobantes-privados"
# S3_ACCESS_KEY_ID="tu-access-key-id"
# S3_SECRET_ACCESS_KEY="tu-secret-access-key"

# Proveedor de correo electrónico transaccional (DRIVERS: "console" o "resend" o "smtp")
EMAIL_DRIVER="console"
EMAIL_FROM="Consultorio Psicológico <turnos@consultorio.com>"
# RESEND_API_KEY="re_123456789"
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT=587
# SMTP_USER="tu-usuario-smtp"
# SMTP_PASS="tu-contraseña-smtp"

# Configuración inicial del primer administrador (usado en prisma/seed.ts)
INITIAL_ADMIN_EMAIL="lic.consultorio@gmail.com"
INITIAL_ADMIN_PASSWORD="CambiarEstaPassword123!"
INITIAL_ADMIN_NAME="Lic. Mariana Gómez"
